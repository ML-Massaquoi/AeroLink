# ---------------------------------------------------------------------------
# AeroLink environment configuration (copy to .env and adjust)
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Core ---
APP_ENV=development                 # development | production | test
APP_NAME=AeroLink
FRONTEND_ORIGIN=http://localhost:3000

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string   # openssl rand -hex 32
SESSION_COOKIE_NAME=aerolink_session
SESSION_MAX_AGE_SECONDS=28800        # 8 hours
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://aerolink:aerolink@localhost:5432/aerolink
POSTGRES_DB=aerolink
POSTGRES_USER=aerolink
POSTGRES_PASSWORD=aerolink           # change for anything non-local
POSTGRES_PORT=5432

# --- Seed data (first boot only; leave blank to skip) ---
SEED_ADMIN_EMAIL=admin@aerolink.dev
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
